{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datascout.local/contracts/run-004/run-control.schema.json",
  "title": "DataScout Run 004 control record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "mode",
    "state",
    "kill_switch",
    "external_actions_enabled",
    "spending_authority_cents",
    "updated_at"
  ],
  "properties": {
    "run_id": { "const": "DS-S2M-004" },
    "mode": { "enum": ["offline", "firestore-emulator", "shadow"] },
    "state": { "enum": ["ready", "running", "stopped", "failed", "cancelled", "completed"] },
    "kill_switch": { "type": "boolean" },
    "external_actions_enabled": { "const": false },
    "spending_authority_cents": { "const": 0 },
    "restart_count": { "type": "integer", "minimum": 0 },
    "checkpoint": { "type": ["object", "null"] },
    "stop_reason": { "type": ["string", "null"] },
    "cancel_reason": { "type": ["string", "null"] },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
