{
  "contractId": "CCLC-001",
  "version": "1.0.0",
  "architectureRef": "A0-COMM-001-v1.0",
  "status": "DESIGN_VALIDATION",
  "authorityEffect": "NONE",
  "purpose": "Provide one portfolio-wide commercial lifecycle and CRM contract shared by Acquisition, Commercial Conversion, Fulfillment and Customer Success.",
  "recordModes": ["SIMULATION", "PRODUCTION"],
  "states": [
    {"id":"LEAD","owner":"Demand & Acquisition","terminal":false},
    {"id":"QUALIFIED_OPPORTUNITY","owner":"Demand & Acquisition","terminal":false},
    {"id":"CONVERSION_ACTIVE","owner":"Commercial Conversion","terminal":false},
    {"id":"PROPOSAL_PENDING","owner":"Commercial Conversion","terminal":false},
    {"id":"COMMERCIAL_ACCEPTED","owner":"Commercial Conversion","terminal":false},
    {"id":"PAYMENT_PENDING","owner":"Commercial Conversion / Client Readiness","terminal":false},
    {"id":"CLIENT_READY","owner":"Client Readiness / Fulfillment Control","terminal":false},
    {"id":"IN_DELIVERY","owner":"Fulfillment Control","terminal":false},
    {"id":"QA_REVIEW","owner":"Independent QA","terminal":false},
    {"id":"DELIVERY_APPROVAL_PENDING","owner":"Delivery Control","terminal":false},
    {"id":"DELIVERED","owner":"Delivery Control","terminal":false},
    {"id":"ACCEPTANCE_SUPPORT","owner":"Customer Success","terminal":false},
    {"id":"SUCCESS_ACTIVE","owner":"Customer Success","terminal":false},
    {"id":"RENEWAL_EXPANSION","owner":"Customer Success / Commercial Conversion","terminal":false},
    {"id":"NURTURE","owner":"Demand & Acquisition or Commercial Conversion","terminal":false},
    {"id":"CLOSED_LOST","owner":"Commercial Conversion","terminal":true},
    {"id":"DO_NOT_CONTACT","owner":"Commercial System","terminal":true},
    {"id":"CANCELLED","owner":"Commercial / Fulfillment owner by stage","terminal":true},
    {"id":"REFUNDED","owner":"Owner / Finance-controlled process","terminal":true},
    {"id":"CHURNED","owner":"Customer Success","terminal":true},
    {"id":"CLOSED_SUCCESS","owner":"Customer Success","terminal":true}
  ],
  "canonicalRecords": {
    "Lead": ["lead_id","contract_version","record_mode","state","source_channel","organization_identity","contact_identity","pain_evidence_refs","communication_state","score","owner","next_action","next_action_owner","next_action_due_at","provenance_refs","correlation_id","idempotency_key","blocked_status","data_sensitivity","created_at","updated_at"],
    "Opportunity": ["opportunity_id","lead_id","contract_version","record_mode","state","need_summary","expected_value_range","decision_maker","fit_evidence_refs","urgency","stage_owner","next_action","next_action_owner","next_action_due_at","provenance_refs","correlation_id","idempotency_key","blocked_status","created_at","updated_at"],
    "ProposalScope": ["proposal_id","opportunity_id","version","hash","price","currency","deliverables","exclusions","assumptions","expires_at","approval_state","send_state","evidence_refs","created_at"],
    "CommercialAcceptance": ["acceptance_id","opportunity_id","proposal_id","accepted_version","accepted_hash","authoritative_contact_id","acceptance_evidence_ref","exceptions","payment_requirement","payment_status","accepted_at"],
    "CustomerAccount": ["customer_id","canonical_organization_identity","contact_ids","communication_preferences","lifecycle_state","account_owner","aliases","source_record_refs","created_at","updated_at"],
    "EngagementProject": ["engagement_id","customer_id","acceptance_id","accepted_scope_version","project_owner","production_adapter","milestones","due_at","dependencies","status","created_at","updated_at"],
    "QADeliveryRecord": ["delivery_id","engagement_id","artifact_version","artifact_hash","qa_verdict","qa_evidence_refs","owner_approval_ref","recipient","route","delivery_receipt_ref","delivered_at"],
    "SuccessRecord": ["success_id","engagement_id","customer_id","acceptance_state","issues","revisions","measured_outcome","satisfaction_evidence_refs","renewal_state","expansion_state","testimonial_permission","referral_permission","case_study_permission","created_at","updated_at"],
    "RevenueEvent": ["revenue_event_id","customer_id","engagement_id","event_type","amount","currency","authoritative_evidence_ref","occurred_at","correlation_id"],
    "LifecycleEvent": ["lifecycle_event_id","subject_type","subject_id","prior_state","new_state","actor_id","reason","evidence_refs","correlation_id","idempotency_key","occurred_at"]
  },
  "revenueEventTypes": ["BOOKED","INVOICED","COLLECTED","REFUNDED","RECURRING_STARTED","RECURRING_STOPPED"],
  "handoffs": {
    "qualified_opportunity_v1": {"sender":"Demand & Acquisition","receiver":"Commercial Conversion","rejectReturnsTo":"Demand & Acquisition"},
    "approved_proposal_v1": {"sender":"Commercial Conversion","receiver":"External Action Approval/Execution Boundary","rejectReturnsTo":"Commercial Conversion"},
    "commercial_acceptance_v1": {"sender":"Commercial Conversion","receiver":"Client Readiness","rejectReturnsTo":"Commercial Conversion"},
    "client_ready_v1": {"sender":"Client Readiness","receiver":"Fulfillment Control","rejectReturnsTo":"Client Readiness"},
    "production_packet_v1": {"sender":"Fulfillment Control","receiver":"Service-specific Production Adapter","rejectReturnsTo":"Fulfillment Control"},
    "qa_eligible_delivery_v1": {"sender":"Production Adapter","receiver":"Independent QA","rejectReturnsTo":"Production Adapter/Fulfillment Control"},
    "approved_delivery_v1": {"sender":"Independent QA + Owner Approval Boundary","receiver":"Delivery Control","rejectReturnsTo":"Fulfillment/QA remediation"},
    "delivered_engagement_v1": {"sender":"Delivery Control","receiver":"Customer Success","rejectReturnsTo":"Delivery Control"},
    "success_outcome_v1": {"sender":"Customer Success","receiver":"Growth/Proof + Analytics","rejectReturnsTo":"Customer Success"},
    "renewal_or_expansion_opportunity_v1": {"sender":"Customer Success","receiver":"Commercial Conversion","rejectReturnsTo":"Customer Success"}
  },
  "transitionRules": [
    {"from":"LEAD","to":"QUALIFIED_OPPORTUNITY","requires":["qualification evidence","communication state","owner","next action"]},
    {"from":"QUALIFIED_OPPORTUNITY","to":"CONVERSION_ACTIVE","requires":["qualified_opportunity_v1 accepted by downstream receiver"]},
    {"from":"CONVERSION_ACTIVE","to":"PROPOSAL_PENDING","requires":["buyer need","authority status","offer/scope basis","next decision"]},
    {"from":"PROPOSAL_PENDING","to":"COMMERCIAL_ACCEPTED","requires":["authoritative acceptance of exact proposal/scope version"]},
    {"from":"COMMERCIAL_ACCEPTED","to":"PAYMENT_PENDING","requires":["documented payment/invoice condition or explicit no-prepayment condition"]},
    {"from":"PAYMENT_PENDING","to":"CLIENT_READY","requires":["applicable payment condition verified","identity verified","authority verified","scope accepted","intake complete","delivery timing recorded","internal ownership accepted"]},
    {"from":"CLIENT_READY","to":"IN_DELIVERY","requires":["client_ready_v1 accepted","approved production adapter assigned"]},
    {"from":"IN_DELIVERY","to":"QA_REVIEW","requires":["exact output/version complete for independent review"]},
    {"from":"QA_REVIEW","to":"DELIVERY_APPROVAL_PENDING","requires":["independent QA PASS for exact version"]},
    {"from":"DELIVERY_APPROVAL_PENDING","to":"DELIVERED","requires":["exact approved version","recipient/route authorization when required","delivery receipt"]},
    {"from":"DELIVERED","to":"ACCEPTANCE_SUPPORT","requires":["Customer Success ownership accepted"]},
    {"from":"ACCEPTANCE_SUPPORT","to":"SUCCESS_ACTIVE","requires":["contracted acceptance/closeout condition or explicit documented exception"]},
    {"from":"SUCCESS_ACTIVE","to":"RENEWAL_EXPANSION","requires":["evidence-backed renewal/retainer/expansion/referral opportunity"]}
  ],
  "globalRequiredFields": ["stable_id","contract_version","record_mode","state","owner","next_action","next_action_owner","next_action_due_at","created_at","updated_at","evidence_or_provenance_refs","correlation_id","idempotency_key","blocked_status","data_sensitivity"],
  "invariants": [
    "No handoff grants authority by itself.",
    "No external message, post, bid, proposal, delivery or profile change occurs without the applicable execution policy/permit.",
    "Payment verification is separate from money movement; no agent may invent payment status.",
    "Production may not begin before CLIENT_READY.",
    "Production and Delivery may not self-issue independent QA PASS.",
    "Delivery requires the exact approved artifact/version and recipient/route authorization when required.",
    "Customer Success ownership must exist before a delivered engagement can be closed out.",
    "Customer claims, logos, testimonials and results require evidence and applicable permission before growth use.",
    "Material commercial facts are versioned or append-only; no silent overwrite.",
    "Unknown external outcome fails closed and is not automatically retried.",
    "A rejected handoff returns ownership to the sender with a remediation reason.",
    "BOOKED, INVOICED and COLLECTED are distinct revenue facts.",
    "Multiple leads/opportunities may map to one CustomerAccount; deduplication preserves aliases, provenance and interaction history."
  ],
  "acceptanceCriteria": [
    "10 canonical record types defined with stable fields.",
    "Every active lifecycle state has a named primary owner.",
    "10 typed handoffs have sender, receiver and reject/remediation semantics.",
    "Payment verification is distinct from money movement.",
    "Independent QA is separated from production/delivery authority.",
    "Customer Success ownership is required after delivery.",
    "Lifecycle history is versioned, append-only for material facts and idempotent.",
    "Run 012 can terminate at qualified_opportunity_v1 without owning downstream sale, delivery or success."
  ]
}
