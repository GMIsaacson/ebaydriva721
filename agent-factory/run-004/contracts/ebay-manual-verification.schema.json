{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "datascout://run-004/ebay-manual-verification/1.0.0",
  "title": "DataScout Manual eBay Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "marketplace",
    "method",
    "verifiedBy",
    "verifiedAt",
    "evidenceRef",
    "exactIdentityConfirmed",
    "observationPeriodDays",
    "unitsSold"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "candidateId": { "type": "string", "pattern": "^DSC-[a-f0-9]{20}$" },
    "marketplace": { "const": "ebay-us" },
    "method": { "enum": ["ebay_product_research_manual", "ebay_manual_completed_listing"] },
    "verifiedBy": { "type": "string", "minLength": 1 },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "evidenceRef": { "type": "string", "minLength": 1 },
    "searchQuery": { "type": ["string", "null"] },
    "exactIdentityConfirmed": { "type": "boolean" },
    "observationPeriodDays": { "type": "integer", "minimum": 1, "maximum": 1095 },
    "unitsSold": { "type": "integer", "minimum": 0 },
    "avgSoldPriceCents": { "type": ["integer", "null"], "minimum": 0 },
    "activeListings": { "type": ["integer", "null"], "minimum": 0 },
    "sellThroughBps": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
    "avgShippingCents": { "type": ["integer", "null"], "minimum": 0 },
    "acceptedOfferPricesIncluded": { "type": ["boolean", "null"] }
  }
}
