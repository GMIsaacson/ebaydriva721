{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AP-RECOVERY-010-D0-HANDOFF-v1.0",
  "title": "Run 010 D0 Recovery Review Handoff",
  "type": "object",
  "required": [
    "handoffId",
    "version",
    "engagementId",
    "vendorId",
    "findingId",
    "issueClass",
    "affectedRecordIds",
    "reviewAmountCents",
    "calculation",
    "governingEvidenceIds",
    "confidence",
    "qaVerdict",
    "findingIdempotencyKey",
    "status",
    "recipientRole",
    "recordDestination",
    "owner",
    "nextAction",
    "authority",
    "externalActionAuthorized",
    "accountingWriteAuthorized",
    "paymentActionAuthorized",
    "moneyMovementAuthorized"
  ],
  "properties": {
    "handoffId": {"type":"string","minLength":1},
    "version": {"const":"1.0"},
    "engagementId": {"type":"string","minLength":1},
    "vendorId": {"type":"string","minLength":1},
    "findingId": {"type":"string","minLength":1},
    "issueClass": {"enum":["DUPLICATE","RATE_MISMATCH","MISSING_CREDIT","UNSUPPORTED_FEE","RECONCILIATION_GAP"]},
    "affectedRecordIds": {"type":"array","minItems":1,"items":{"type":"string"}},
    "reviewAmountCents": {"type":"integer","minimum":0},
    "calculation": {"type":"string","minLength":1},
    "governingEvidenceIds": {"type":"array","minItems":1,"items":{"type":"string"}},
    "confidence": {"type":"number","minimum":0,"maximum":1},
    "unresolvedQuestions": {"type":"array","items":{"type":"string"}},
    "qaVerdict": {"enum":["PASS","REMEDIATE","REJECT"]},
    "findingIdempotencyKey": {"type":"string","minLength":1},
    "status": {"enum":["OWNER_REVIEW_READY","REMEDIATION_REQUIRED"]},
    "recipientRole": {"const":"Aberdeen Owner Review Queue"},
    "recordDestination": {"const":"Notion / Run 010 D0 Downstream Acceptance Record"},
    "owner": {"const":"Aberdeen Technologies"},
    "nextAction": {"type":"string","minLength":1},
    "remediationReasons": {"type":"array","items":{"type":"string"}},
    "authority": {"const":"INTERNAL_REVIEW_ONLY"},
    "externalActionAuthorized": {"const":false},
    "accountingWriteAuthorized": {"const":false},
    "paymentActionAuthorized": {"const":false},
    "moneyMovementAuthorized": {"const":false}
  },
  "additionalProperties": false
}
