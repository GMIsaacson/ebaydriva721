      "position": [
        -390,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "RUN006POSTGRES",
          "name": "Run 006 Private PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows=$input.all().map(i=>i.json.packet||i.json).filter(Boolean);\nconst changed=rows.filter(p=>p.eventType==='STATE_CHANGED');\nconst violations=[];\nif(changed.length>3) violations.push('changed-route cap exceeded');\nfor(const p of rows){\n  const c=p.control||{};\n  if(!['Observe','Recommend'].includes(p.authorityLevel)) violations.push('authority expansion');\n  if(c.maxChangedPerRun!==3) violations.push('wrong batch cap');\n  if(c.externalActionsEnabled!==false) violations.push('external actions enabled');\n  if(c.spendingAuthorityCents!==0) violations.push('spending authority');\n  if(c.workControlDispatchAllowed!==false) violations.push('work control dispatch authority');\n  if(c.routeMutationAllowed!==false) violations.push('route mutation authority');\n}\nreturn [{json:{\n  runId:'DS-S2M-004',\n  gate:'G6',\n  workflowId:'SOURCEMARGINACQDISPATCHG6',\n  unitId:'WF-SM-ACQ-DISPATCH-G6-001',\n  approvalRef:'CHATGPT-OWNER-APPROVAL-2026-09-20-SM-ACQ-DISPATCH',\n  mode:'CONTROLLED_LIVE_INTERNAL_MONITOR',\n  control:{maxChangedPerRun:3,externalActionsEnabled:false,spendingAuthorityCents:0,workControlDispatchAllowed:false,routeMutationAllowed:false},\n  packetCount:rows.length,\n  changedCount:changed.length,\n  eventTypes:rows.map(p=>p.eventType),\n  packets:rows,\n  guardStatus:violations.length?'Rejected':'Accepted',\n  violations,\n  externalActions:0,\n  spendingCents:0,\n  workControlCommandsCreated:0\n}}];"
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Authority Guard + Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT cil_close_run('SOURCEMARGINACQDISPATCHG6:' || $1, 'COMPLETED', 100::numeric, 0, $2::bigint, $3, 0, 0, 0, $4::jsonb) AS compliance_status;",
        "options": {
          "queryReplacement": "={{ [$execution.id, Date.now() - new Date($execution.startedAt || Date.now()).getTime(), $json.guardStatus === 'Accepted' ? 'Pass' : 'Review', JSON.stringify({workflowId:'SOURCEMARGINACQDISPATCHG6',runType:'ACQUISITION-STATE-MONITOR',gate:'G6',approvalRef:'CHATGPT-OWNER-APPROVAL-2026-09-20-SM-ACQ-DISPATCH',changedCount:$json.changedCount,eventTypes:$json.eventTypes,externalActions:0,spendingCents:0,workControlCommandsCreated:0})] }}"
        }
      },
