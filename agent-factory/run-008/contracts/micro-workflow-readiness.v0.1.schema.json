{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/contracts/micro-workflow-readiness.v0.1.schema.json",
  "title": "Factory micro-workflow readiness contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflowId",
    "version",
    "owner",
    "priority",
    "requires",
    "blocksIf",
    "produces",
    "authority"
  ],
  "properties": {
    "workflowId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "owner": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "dispatchTarget": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["WORK_CONTROL_WORKER", "N8N_WORKFLOW", "INTERNAL_SERVICE", "NONE"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "requires": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/predicate" }
    },
    "blocksIf": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/blockPredicate" }
    },
    "produces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "externalActionAuthorized", "costCeilingCents"],
      "properties": {
        "mode": {
          "enum": ["OBSERVE", "INTERNAL_WRITE", "EXTERNAL_WRITE_GATED"]
        },
        "externalActionAuthorized": {
          "type": "boolean"
        },
        "costCeilingCents": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact", "operator"],
      "properties": {
        "fact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "operator": {
          "enum": [
            "EXISTS",
            "NOT_EXISTS",
            "EQ",
            "NEQ",
            "IN",
            "NOT_IN",
            "GTE",
            "LTE",
            "GT",
            "LT",
            "TRUE",
            "FALSE"
          ]
        },
        "value": {}
      }
    },
    "blockPredicate": {
      "allOf": [
        { "$ref": "#/$defs/predicate" },
        {
          "type": "object",
          "required": ["reason"],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        }
      ]
    }
  }
}