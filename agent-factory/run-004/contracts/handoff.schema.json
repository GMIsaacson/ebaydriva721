{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datascout.local/contracts/run-004/handoff.schema.json",
  "title": "DataScout Run 004 typed handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "handoff_id",
    "idempotency_key",
    "producer_agent_id",
    "consumer_agent_id",
    "opportunity_url",
    "candidate_ids",
    "evidence_refs",
    "decision_requested",
    "expires_at",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "const": "DS-S2M-004" },
    "handoff_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "idempotency_key": {
      "type": "string",
      "pattern": "^DS-S2M-004:(H1|H2|H3|H4):[a-fA-F0-9]{8,64}$"
    },
    "producer_agent_id": {
      "enum": [
        "AGT-PORTFOLIO-STEWARD-001",
        "AGT-RESEARCH-VALIDATION-001",
        "AGT-OFFER-ASSET-BUILDER-001",
        "OWNER-ABERDEEN"
      ]
    },
    "consumer_agent_id": {
      "enum": [
        "AGT-PORTFOLIO-STEWARD-001",
        "AGT-RESEARCH-VALIDATION-001",
        "AGT-OFFER-ASSET-BUILDER-001",
        "OWNER-ABERDEEN"
      ]
    },
    "opportunity_url": { "type": "string", "minLength": 1 },
    "candidate_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_url", "captured_at", "evidence_type", "confidence"],
        "properties": {
          "source_url": { "type": "string", "minLength": 1 },
          "captured_at": { "type": "string", "format": "date-time" },
          "evidence_type": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["high", "medium", "low", "synthetic"] }
        }
      }
    },
    "decision_requested": { "type": "string", "minLength": 1, "maxLength": 500 },
    "approval_ref": { "type": ["string", "null"], "maxLength": 256 },
    "expires_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["Accepted", "Rejected", "Incomplete", "Review", "Cancelled"] },
    "rejection_reason": { "type": ["string", "null"], "maxLength": 1000 },
    "recovery_action": { "type": ["string", "null"], "maxLength": 1000 }
  }
}
